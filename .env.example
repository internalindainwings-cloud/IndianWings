# ── Production Environment Variables Template ──────────────────────────────
# Copy this file to .env and fill in real secrets before deploying to production.

# 1. Database Connection (PostgreSQL with SSL enabled in production)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# 2. Canonical Production Website URL (No trailing slash)
NEXT_PUBLIC_SITE_URL="https://theindianwings.com"

# 3. Admin Security & Vault (Generate high-entropy random strings)
# e.g., openssl rand -base64 32
ADMIN_SECRET_KEY="generate-strong-random-secret-key-for-hmac-sha256"
ADMIN_PASSWORD="generate-strong-complex-admin-password"
ADMIN_API_SECRET="generate-strong-internal-api-bearer-secret"

# 4. Optional Third-Party Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# 5. Botpress AI Chatbot (Client ID for webchat embed; safe for client)
NEXT_PUBLIC_BOTPRESS_CLIENT_ID=""
