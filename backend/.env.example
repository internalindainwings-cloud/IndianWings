# The Indian Wings Company — Express Backend API Environment Variables
# For local development, copy this file to .env

# Server
PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL connection string with pooled connection)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin Authentication
ADMIN_PASSWORD=change-to-your-secure-admin-password
ADMIN_SECRET_KEY=change-to-at-least-32-characters-random-secret-key-12345
ADMIN_API_SECRET=change-to-internal-api-secret

# Distributed Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Frontend Origin for CORS & Origin Guard
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Dispatch (Optional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@theindianwingscompany.com
SMTP_PASS=your-app-password
SMTP_FROM="The Indian Wings Company" <info@theindianwingscompany.com>

# Cache Revalidation (Optional)
VERCEL_REVALIDATE_TOKEN=optional-revalidation-token
