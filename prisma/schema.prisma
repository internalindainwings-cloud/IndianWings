generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Enquiry {
  id          String        @id @default(uuid())
  name        String
  phone       String
  email       String?
  travelDate  String
  guests      String        @default("2-4 Guests")
  tripType    String        @default("Kashmir Classic")
  message     String?
  source      String        @default("website_inline")
  
  // Attribution & Ad tracking
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  referrer    String?
  visitorId   String?

  // Lifecycle & Metadata
  status      EnquiryStatus @default(NEW)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
  @@map("enquiries")
}

model UserSession {
  id              String         @id @default(uuid())
  visitorId       String
  name            String?        // Populated if visitor enquires
  phone           String?        // Populated if visitor enquires
  email           String?        
  ipAddress       String?
  city            String?        
  device          String?        // Mobile, Tablet, Desktop
  browser         String?        // Chrome, Safari, etc.
  utmSource       String?        // google_ads, meta, etc.
  utmCampaign     String?        
  referrer        String?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?      
  durationSeconds Int            @default(0)
  converted       Boolean        @default(false)
  enquiryId       String?        
  events          SessionEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([visitorId])
  @@index([createdAt])
  @@index([converted])
  @@map("user_sessions")
}

model SessionEvent {
  id            String       @id @default(uuid())
  sessionId     String
  session       UserSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType     String       // PAGE_VIEW, SCROLL_DEPTH, CARD_CLICK, MODAL_OPEN, EXIT
  route         String       // "/", "/packages", etc.
  label         String?      // e.g. "Kashmir Honeymoon Special", "⚡ Quote CTA"
  durationSpent Int?         // Seconds spent on this page/element
  metadata      Json?        // Additional details e.g. { scrollPercent: 75 }
  timestamp     DateTime     @default(now())

  @@index([sessionId])
  @@index([timestamp])
  @@index([eventType])
  @@map("session_events")
}

model PackageCategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  packages    Package[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("package_categories")
}

model Package {
  id            String           @id @default(uuid())
  slug          String           @unique
  title         String
  categorySlug  String           @default("featured")
  categoryId    String?
  category      PackageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  duration      String
  tag           String           @default("Best Seller")
  tagColor      String?
  imageUrl      String
  videoUrl      String?
  galleryUrls   String[]         @default([])
  rating        Float            @default(4.9)
  reviewCount   Int              @default(120)
  destinations  String[]         @default([])
  inclusions    String[]         @default([])
  exclusions    String[]         @default([])
  highlights    String[]         @default([])
  startingPrice Int
  originalPrice Int?
  isFeatured    Boolean          @default(false)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)

  itinerary     Json?

  metaTitle       String?
  metaDescription String?
  keywords        String[]       @default([])
  canonicalUrl    String?
  noIndex         Boolean        @default(false)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categorySlug])
  @@index([slug])
  @@index([isActive])
  @@map("packages")
}

model SiteSetting {
  id                  String   @id @default("global")
  siteTitle           String   @default("The Indian Wings Company | Premium Kashmir Travel")
  siteDesc            String   @default("Curated Kashmir holiday packages, luxury stays, and private transfers.")
  robotsTxtCustom     String?
  phone               String   @default("+91 99060 00000")
  email               String   @default("info@theindianwingscompany.com")
  whatsapp            String   @default("+919906000000")
  address             String   @default("Boulevard Road, Dal Lake, Srinagar, Jammu & Kashmir 190001")
  announcementEnabled Boolean  @default(false)
  announcementText    String   @default("Special Seasonal Offer: Enjoy exclusive seasonal discounts on advance Kashmir holiday bookings!")
  announcementLink    String   @default("/packages")
  heroConfig          Json?
  logoUrl             String?
  heroImageUrl        String?
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}


model Destination {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  region               String   @default("Jammu & Kashmir")
  tagline              String
  category             String   @default("Iconic") // Iconic, Alpine, Off-Beat
  imageUrl             String
  gallery              String[] @default([])
  elevation            String   @default("1,585 m")
  bestSeason           String   @default("All Year Round")
  distanceFromSrinagar String   @default("0 km")
  highlights           String[] @default([])
  description          String
  packageCount         Int      @default(0)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("destinations")
}

model Activity {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  location    String
  category    String   @default("Snow & Winter") // Snow & Winter, Water Sports, Aerial & Flying, Trails & Off-Road
  duration    String   @default("2-4 hrs")
  difficulty  String   @default("Beginner to Pro")
  season      String   @default("All Year")
  imageUrl    String
  tags        String[] @default([])
  badge       String?
  priceFrom   Int      @default(1500)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@index([isActive])
  @@map("activities")
}

model TransportVehicle {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  category    String   @default("Luxury MPV") // Sedan / Hatch, Luxury MPV, VIP SUV, Group Traveller, Adventure 4x4
  seats       String   @default("6+1 Seats")
  bags        String   @default("4 Bags")
  ac          String   @default("AC & Heater")
  fuel        String   @default("Diesel")
  imageUrl    String
  pricePerDay Int      @default(3500)
  tags        String[] @default([])
  badge       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("transport_vehicles")
}

model TransportRoute {
  id           String   @id @default(uuid())
  origin       String   @default("Srinagar")
  destination  String
  routeTitle   String
  via          String
  distance     String
  duration     String
  startingPrice Int     @default(2500)
  highlights   String[] @default([])
  cabs         String   @default("Sedan, Innova Crysta, Tempo")
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([origin])
  @@index([isActive])
  @@map("transport_routes")
}

model CustomerReview {
  id            String   @id @default(uuid())
  name          String
  city          String
  review        String
  rating        Int      @default(5)
  avatarUrl     String?
  type          String   @default("written") // written, video, gallery
  videoUrl      String?
  videoDuration String?
  videoQuote    String?
  imageUrl      String?
  featured      Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([featured])
  @@index([isActive])
  @@map("customer_reviews")
}

model Blog {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  excerpt         String?  @db.Text
  authorName      String   @default("The Indian Wings")
  authorAvatar    String?
  category        String   @default("Travel Guide")
  imageUrl        String
  isPublished     Boolean  @default(false)
  readTime        String   @default("5 min read")
  
  // SEO Metadata
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  noIndex         Boolean  @default(false)

  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([category])
  @@map("blogs")
}
